# ===== 运行环境 =====
# dev：本地开发；未配置 API_ACCESS_TOKEN 时仅放行本机回环地址(127.0.0.1/::1)
# prod：生产环境；启动时强制校验 API_ACCESS_TOKEN 必须存在且不少于16位，
#       且必须配置 DEEPSEEK_API_KEY，否则进程直接启动失败
APP_ENV=dev

# ===== 大模型配置 =====
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥
DEEPSEEK_URL=https://api.deepseek.com/v1/chat/completions
# 模型名支持别名，例如 deepseek-chat / deepseek-v4-flash，实际都会解析到 deepseek-flash
DEEPSEEK_MODEL=deepseek-chat
# 生成温度，0~1 之间，越小越稳定；缺省 0.1
DEEPSEEK_TEMPERATURE=0.1
# 单次大模型调用的超时秒数，缺省 60
DEEPSEEK_TIMEOUT=60

# ===== 接口鉴权 =====
# 所有业务接口需在请求头携带 X-Access-Token，取值即本项
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(32))"
API_ACCESS_TOKEN=请替换为随机长字符串

# ===== 提示词 =====
SYSTEM_PROMPT=请严格基于参考文档回答用户问题，如果文档没有相关信息如实告知，不要编造任何内容。

# ===== 存储与上传（一般只在需要改路径时配置） =====
# 上传文件存放目录，缺省 ./uploads
# RAG_UPLOAD_DIR=./uploads
# 上传文件大小上限（MB），缺省 50
# MAX_UPLOAD_MB=50
# 同时执行解析入库的任务数上限，缺省 4
# MAX_CONCURRENT_INGEST=4
# 会话库目录；缺省 <项目>/data
# RAG_DATA_DIR=./data
# 会话库完整路径，优先级高于 RAG_DATA_DIR
# RAG_SESSION_DB=./data/session.db

# ===== 限流与展示 =====
# 限流规则，缺省 20/minute
# RAG_RATE_LIMIT=20/minute
# OpenAPI 文档里展示的版本号，缺省 1.0.0
# RAG_APP_VERSION=1.0.0

# ===== 模型加载 =====
# 缺省离线（1）：不为模型元数据向 huggingface.co 发请求。
# 网络不通时，transformers 会重试 5 次并逐个超时，导致启动卡数分钟。
# 需要检查模型更新时设为 0。
# RAG_HF_OFFLINE=1
