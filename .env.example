# ===== 运行环境 =====
# dev：本地开发；未配置 API_ACCESS_TOKEN 时仅放行本机回环地址(127.0.0.1/::1)
# prod：生产环境；启动时强制校验 API_ACCESS_TOKEN 必须存在且不少于16位，否则进程直接启动失败
APP_ENV=dev

# ===== 大模型配置 =====
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥
DEEPSEEK_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# ===== 接口鉴权 =====
# 所有业务接口需在请求头携带 X-Access-Token，取值即本项
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(32))"
API_ACCESS_TOKEN=请替换为随机长字符串

# ===== 提示词 =====
SYSTEM_PROMPT=请严格基于参考文档回答用户问题，如果文档没有相关信息如实告知，不要编造任何内容。
