# 密钥环境变量
.env

# 上传的PDF文件
uploads/

# 向量库与本地数据（含会话库）
chroma_db/
data/

# python缓存
__pycache__/
*.pyc
*.pyo

# 虚拟环境
venv/

# 日志
*.log
logs/*

